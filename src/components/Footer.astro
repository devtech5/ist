---
import { menu, cta, contact, site, reseaux } from "../data/site.js";

const reseauxActifs = reseaux.filter((reseau) => reseau.url);
const annee = new Date().getFullYear();
---

<footer class="mt-24 bg-ist-blue-dark text-slate-200">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img
          src="/images/logo-ist.png"
          alt=""
          width="56"
          height="56"
          class="h-14 w-14 rounded-full bg-white object-contain p-1"
        />
        <div>
          <p class="font-display text-xl font-bold text-white">{site.sigle}</p>
          <p class="text-sm text-slate-300">{site.nom}</p>
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-slate-300">
        {site.baseline}, créée le {site.creation}. {site.devise}.
      </p>
    </div>

    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
        Navigation
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          [...menu, cta].map((item) => (
            <li>
              <a class="text-slate-300 transition hover:text-white" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
        Contact
      </h2>
      <ul class="mt-4 space-y-2 text-sm text-slate-300">
        <li>{contact.siege}</li>
        <li>{contact.ville}</li>
        <li>{contact.boitePostale}</li>
        <li>
          <a class="transition hover:text-white" href={`tel:${contact.telephoneLien}`}>
            {contact.telephone}
          </a>
        </li>
        <li>
          <a class="transition hover:text-white" href={`tel:${contact.mobileLien}`}>
            {contact.mobile}
          </a>
        </li>
        <li>
          <a class="transition hover:text-white" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        </li>
      </ul>

      {
        reseauxActifs.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-3 text-sm">
            {reseauxActifs.map((reseau) => (
              <li>
                <a
                  class="rounded-full border border-white/25 px-3 py-1.5 transition hover:bg-white hover:text-ist-blue-dark"
                  href={reseau.url}
                  rel="noopener"
                >
                  {reseau.nom}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p>© {annee} {site.nom} — Tous droits réservés.</p>
      <p>
        <a class="transition hover:text-white" href="/mentions-legales/"
          >Mentions légales</a
        >
      </p>
    </div>
  </div>
</footer>
