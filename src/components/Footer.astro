---
import { menu, cta, contact, site, reseaux } from "../data/site.js";
import { t, lien, langues, nomsLangues, equivalent } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;
const reseauxActifs = reseaux.filter((reseau) => reseau.url);
const annee = new Date().getFullYear();
---

<footer class="mt-24 bg-ist-900 text-ist-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img
          src="/images/logo-ist.png"
          alt=""
          width="56"
          height="56"
          class="h-14 w-14 rounded-full bg-white object-contain p-1"
        />
        <div>
          <p class="font-display text-xl font-bold text-white">{site.sigle}</p>
          <p class="text-sm text-ist-200">{site.nom}</p>
        </div>
      </div>
      <p class="mt-5 text-sm leading-relaxed text-ist-200">
        {t(site.baseline, lang)} — {t(site.devise, lang)}.
      </p>

      {
        reseauxActifs.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {reseauxActifs.map((reseau) => (
              <li>
                <a
                  class="rounded-full border border-white/20 px-4 py-1.5 text-sm transition hover:bg-white hover:text-ist-900"
                  href={reseau.url}
                  target="_blank"
                  rel="noopener"
                >
                  {reseau.nom}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-widest text-white">
        {t(ui.general.navigationPied, lang)}
      </h2>
      <ul class="mt-5 space-y-2.5 text-sm">
        {
          [...menu, cta].map((item) => (
            <li>
              <a
                class="text-ist-200 transition hover:text-white"
                href={lien(lang, item.chemin)}
              >
                {t(ui.menu[item.cle], lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-widest text-white">
        {t(ui.contact.titre, lang)}
      </h2>
      <ul class="mt-5 space-y-2.5 text-sm text-ist-200">
        <li>{t(contact.siege, lang)}</li>
        <li>{t(contact.ville, lang)}</li>
        <li>{contact.boitePostale}</li>
        <li>
          <a class="transition hover:text-white" href={`tel:${contact.telephoneLien}`}>
            {contact.telephone}
          </a>
        </li>
        <li>
          <a class="transition hover:text-white" href={`tel:${contact.mobileLien}`}>
            {contact.mobile}
          </a>
        </li>
        <li>
          <a class="transition hover:text-white" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        </li>
      </ul>

      <ul class="mt-6 flex gap-2">
        {
          langues.map((code) => (
            <li>
              <a
                href={equivalent(Astro.url, code)}
                hreflang={code}
                class:list={[
                  "rounded-full px-4 py-1.5 text-sm transition",
                  code === lang
                    ? "bg-white font-semibold text-ist-900"
                    : "border border-white/20 text-ist-200 hover:text-white",
                ]}
              >
                {nomsLangues[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-ist-300 sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p>© {annee} {site.nom} — {t(ui.general.tousDroits, lang)}</p>
      <p>
        <a class="transition hover:text-white" href={lien(lang, "mentions-legales")}>
          {t(ui.legal.titre, lang)}
        </a>
      </p>
    </div>
  </div>
</footer>
