---
// Trame de points, dans l'esprit du « dot pattern » de Magic UI. Purement
// décorative : elle reste derrière le contenu et se fond sur les bords.
const { classe = "" } = Astro.props;
---

<div
  class:list={["pointer-events-none absolute inset-0 overflow-hidden", classe]}
  aria-hidden="true"
>
  <svg class="size-full" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern
        id="motif-points"
        width="24"
        height="24"
        patternUnits="userSpaceOnUse"
        patternContentUnits="userSpaceOnUse"
      >
        <circle cx="1.2" cy="1.2" r="1.2" fill="currentColor"></circle>
      </pattern>
      <radialGradient id="fondu-points">
        <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
        <stop offset="70%" stop-color="white" stop-opacity="0.35"></stop>
        <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="masque-points">
        <rect width="100%" height="100%" fill="url(#fondu-points)"></rect>
      </mask>
    </defs>
    <rect
      width="100%"
      height="100%"
      fill="url(#motif-points)"
      mask="url(#masque-points)"></rect>
  </svg>
</div>
