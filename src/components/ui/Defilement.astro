---
// Bandeau défilant, dans l'esprit du composant « marquee » de Magic UI,
// réécrit ici en CSS pur. Le contenu est dupliqué pour que la boucle soit
// continue ; la copie est masquée aux lecteurs d'écran.
//
// Chaque élément attend { nom, sigle, logo } : le logo s'affiche dès qu'un
// fichier est renseigné, sinon une pastille portant le sigle tient la place.
const { elements = [], duree = 46 } = Astro.props;
---

<div
  class="groupe-defilant relative flex w-full overflow-hidden"
  style={`--duree:${duree}s; --espace:3rem;`}
>
  {
    [0, 1].map((copie) => (
      <ul
        class="piste-defilante flex shrink-0 items-center gap-10 pr-10"
        aria-hidden={copie === 1 ? "true" : undefined}
      >
        {elements.map((element) => (
          <li class="flex shrink-0 items-center gap-3">
            {element.logo ? (
              <img
                src={element.logo}
                alt={element.nom}
                loading="lazy"
                decoding="async"
                class="h-12 w-auto max-w-[7.5rem] object-contain opacity-90 transition duration-300 hover:scale-105 hover:opacity-100"
              />
            ) : (
              <span class="grid size-11 shrink-0 place-items-center rounded-lg border border-bordure bg-fond font-display text-xs font-bold tracking-tight text-ist-600">
                {element.sigle}
              </span>
            )}
            <span class="whitespace-nowrap font-display text-base font-medium text-encre-douce">
              {element.nom}
            </span>
          </li>
        ))}
      </ul>
    ))
  }

  <!-- Fondus latéraux : le bandeau se perd dans le fond plutôt que d'être coupé net. -->
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-voile to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-voile to-transparent"
    aria-hidden="true"
  >
  </div>
</div>
