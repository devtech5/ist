---
import { menu, cta, site } from "../data/site.js";
import { t, lien, langues, nomsLangues, equivalent } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;
const { pathname } = Astro.url;

const estActif = (chemin) => {
  const cible = lien(lang, chemin);
  return chemin === "" ? pathname === cible : pathname.startsWith(cible);
};
---

<header
  class="sticky top-0 z-40 border-b border-ist-100 bg-white/90 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href={lien(lang)} class="flex items-center gap-3">
      <img
        src="/images/logo-ist.png"
        alt={`${site.sigle} — ${site.nom}`}
        width="48"
        height="48"
        class="h-11 w-11 shrink-0 object-contain"
      />
      <span class="leading-tight">
        <span class="block font-display text-lg font-bold tracking-tight text-ist-600"
          >{site.sigle}</span
        >
        <span class="hidden text-[11px] font-medium text-slate-500 sm:block sm:text-xs"
          >{site.nom}</span
        >
      </span>
    </a>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <!-- Sélecteur de langue : le chemin équivalent est calculé côté serveur. -->
      <div
        class="hidden items-center rounded-full border border-ist-100 p-0.5 sm:flex"
        role="group"
        aria-label={t(ui.general.changerLangue, lang)}
      >
        {
          langues.map((code) => (
            <a
              href={equivalent(Astro.url, code)}
              hreflang={code}
              aria-current={code === lang ? "true" : undefined}
              title={nomsLangues[code]}
              class:list={[
                "rounded-full px-3 py-1.5 text-xs font-bold uppercase transition",
                code === lang
                  ? "bg-ist-600 text-white"
                  : "text-slate-500 hover:bg-ist-50 hover:text-ist-600",
              ]}
            >
              {code}
            </a>
          ))
        }
      </div>

      <a
        href={lien(lang, cta.chemin)}
        class="hidden rounded-full bg-ist-red px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-ist-red-dark hover:shadow-md sm:inline-block"
        >{t(ui.menu.don, lang)}</a
      >

      <button
        type="button"
        id="menu-ouvrir"
        aria-controls="menu-principal"
        aria-expanded="false"
        class="flex items-center gap-2 rounded-full border border-ist-200 px-4 py-2.5 text-sm font-semibold text-ist-600 transition hover:border-ist-600 hover:bg-ist-50"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span class="uppercase tracking-wide">{t(ui.menu.ouvrir, lang)}</span>
      </button>
    </div>
  </div>
</header>

<!-- Panneau de navigation : même principe sur mobile et sur ordinateur. -->
<div
  id="menu-principal"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t(ui.menu.navigation, lang)}
>
  <div id="menu-fond" class="absolute inset-0 bg-ist-900/60 backdrop-blur-sm"></div>

  <nav
    id="menu-panneau"
    class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col overflow-y-auto bg-white px-8 py-8 shadow-2xl transition-transform duration-300 ease-out"
  >
    <button
      type="button"
      id="menu-fermer"
      class="self-end rounded-full bg-ist-600 p-2.5 text-white transition hover:bg-ist-700"
      aria-label={t(ui.menu.fermer, lang)}
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <img
      src="/images/logo-ist.png"
      alt=""
      width="120"
      height="120"
      class="mx-auto mt-4 h-24 w-24 object-contain"
    />

    <ul class="mt-8 space-y-1 text-center">
      {
        menu.map((item) => (
          <li>
            <a
              href={lien(lang, item.chemin)}
              aria-current={estActif(item.chemin) ? "page" : undefined}
              class:list={[
                "block rounded-xl px-4 py-3 font-display text-lg font-semibold transition hover:bg-ist-50",
                estActif(item.chemin) ? "text-ist-red" : "text-ist-700",
              ]}
            >
              {t(ui.menu[item.cle], lang)}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={lien(lang, cta.chemin)}
      class="mt-7 block rounded-full bg-ist-red px-6 py-3.5 text-center font-display text-base font-semibold text-white transition hover:bg-ist-red-dark"
      >{t(ui.menu.don, lang)}</a
    >

    <div class="mt-7 flex justify-center gap-2">
      {
        langues.map((code) => (
          <a
            href={equivalent(Astro.url, code)}
            hreflang={code}
            class:list={[
              "rounded-full border px-4 py-2 text-sm font-semibold transition",
              code === lang
                ? "border-ist-600 bg-ist-600 text-white"
                : "border-ist-100 text-slate-500 hover:border-ist-600 hover:text-ist-600",
            ]}
          >
            {nomsLangues[code]}
          </a>
        ))
      }
    </div>

    <p class="mt-auto pt-8 text-center surtitre">{t(site.devise, lang)}</p>
  </nav>
</div>

<script>
  const panneauRacine = document.getElementById("menu-principal");
  const panneau = document.getElementById("menu-panneau");
  const ouvrir = document.getElementById("menu-ouvrir");
  const fermer = document.getElementById("menu-fermer");
  const fond = document.getElementById("menu-fond");

  const ouvrirMenu = () => {
    panneauRacine?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    ouvrir?.setAttribute("aria-expanded", "true");
    // setTimeout plutot que requestAnimationFrame : ce dernier est suspendu
    // quand l'onglet n'est pas visible, le panneau resterait hors ecran.
    setTimeout(() => panneau?.classList.remove("translate-x-full"), 10);
    fermer?.focus();
  };

  const fermerMenu = () => {
    panneau?.classList.add("translate-x-full");
    document.body.style.overflow = "";
    ouvrir?.setAttribute("aria-expanded", "false");
    setTimeout(() => panneauRacine?.classList.add("hidden"), 300);
    ouvrir?.focus();
  };

  ouvrir?.addEventListener("click", ouvrirMenu);
  fermer?.addEventListener("click", fermerMenu);
  fond?.addEventListener("click", fermerMenu);
  document.addEventListener("keydown", (evenement) => {
    if (evenement.key === "Escape" && !panneauRacine?.classList.contains("hidden")) {
      fermerMenu();
    }
  });
</script>
