---
import { menu, cta, site } from "../data/site.js";
import { t, lien, langues, nomsLangues, equivalent } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

// `flottant` : la barre se pose par-dessus le diaporama, transparente, et
// reprend son fond dès que la page défile.
const { lang, flottant = false } = Astro.props;
const { pathname } = Astro.url;

const estActif = (chemin) => {
  const cible = lien(lang, chemin);
  return chemin === "" ? pathname === cible : pathname.startsWith(cible);
};
---

<header
  id="entete"
  data-flottant={flottant ? "true" : "false"}
  class:list={[
    "top-0 z-40 w-full transition-[background-color,border-color,box-shadow] duration-500",
    flottant ? "fixed bg-transparent" : "sticky border-b border-bordure bg-fond/90 backdrop-blur-md",
  ]}
>
  <div class="mx-auto flex w-full max-w-6xl items-center gap-4 px-5 py-4 sm:px-8">
    <a href={lien(lang)} class="flex items-center gap-3">
      <span
        class="grid size-11 shrink-0 place-items-center rounded-lg bg-white transition-shadow"
      >
        <img
          src="/images/logo-ist.png"
          alt={`${site.sigle} — ${site.nom}`}
          width="44"
          height="44"
          class="size-9 object-contain"
        />
      </span>
      <span class="leading-tight">
        <span
          class="entete-titre block font-display text-lg font-bold tracking-tight transition-colors"
          >{site.sigle}</span
        >
        <span
          class="entete-sous-titre hidden text-[11px] font-medium transition-colors sm:block sm:text-xs"
          >{site.nom}</span
        >
      </span>
    </a>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <div
        class="entete-langues hidden items-center rounded-lg border p-0.5 transition-colors sm:flex"
        role="group"
        aria-label={t(ui.general.changerLangue, lang)}
      >
        {
          langues.map((code) => (
            <a
              href={equivalent(Astro.url, code)}
              hreflang={code}
              aria-current={code === lang ? "true" : undefined}
              title={nomsLangues[code]}
              data-langue-active={code === lang ? "true" : "false"}
              class="entete-langue rounded-md px-3 py-1.5 text-xs font-bold uppercase transition-colors"
            >
              {code}
            </a>
          ))
        }
      </div>

      <a
        href={lien(lang, cta.chemin)}
        class="hidden rounded-lg bg-ist-red px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-ist-red-dark active:translate-y-px sm:inline-block"
        >{t(ui.menu.don, lang)}</a
      >

      <button
        type="button"
        id="menu-ouvrir"
        aria-controls="menu-principal"
        aria-expanded="false"
        class="entete-bouton flex items-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-semibold transition-colors"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span class="uppercase tracking-wide">{t(ui.menu.ouvrir, lang)}</span>
      </button>
    </div>
  </div>
</header>

<!-- Panneau de navigation : même principe sur mobile et sur ordinateur. -->
<div
  id="menu-principal"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t(ui.menu.navigation, lang)}
>
  <div id="menu-fond" class="absolute inset-0 bg-ist-900/60 backdrop-blur-sm"></div>

  <nav
    id="menu-panneau"
    class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col overflow-y-auto bg-fond px-8 py-8 shadow-2xl transition-transform duration-300 ease-out"
  >
    <button
      type="button"
      id="menu-fermer"
      class="self-end rounded-lg bg-ist-600 p-2.5 text-white transition hover:bg-ist-700"
      aria-label={t(ui.menu.fermer, lang)}
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <img
      src="/images/logo-ist.png"
      alt=""
      width="120"
      height="120"
      class="mx-auto mt-4 size-24 object-contain"
    />

    <ul class="mt-8 space-y-1 text-center">
      {
        menu.map((item) => (
          <li>
            <a
              href={lien(lang, item.chemin)}
              aria-current={estActif(item.chemin) ? "page" : undefined}
              class:list={[
                "block rounded-lg px-4 py-3 font-display text-lg font-semibold transition hover:bg-ist-50",
                estActif(item.chemin) ? "text-ist-red" : "text-ist-700",
              ]}
            >
              {t(ui.menu[item.cle], lang)}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={lien(lang, cta.chemin)}
      class="mt-7 block rounded-lg bg-ist-red px-6 py-3.5 text-center font-display text-base font-semibold text-white transition hover:bg-ist-red-dark"
      >{t(ui.menu.don, lang)}</a
    >

    <div class="mt-7 flex justify-center gap-2">
      {
        langues.map((code) => (
          <a
            href={equivalent(Astro.url, code)}
            hreflang={code}
            class:list={[
              "rounded-lg border px-4 py-2 text-sm font-semibold transition",
              code === lang
                ? "border-ist-600 bg-ist-600 text-white"
                : "border-bordure text-encre-douce hover:border-ist-600 hover:text-ist-600",
            ]}
          >
            {nomsLangues[code]}
          </a>
        ))
      }
    </div>

    <p class="mt-auto justify-center pt-8 surtitre">{t(site.devise, lang)}</p>
  </nav>
</div>

<style>
  /* Barre posée sur le diaporama : tout passe en blanc. */
  #entete[data-flottant="true"]:not(.est-opaque) .entete-titre,
  #entete[data-flottant="true"]:not(.est-opaque) .entete-sous-titre {
    color: #fff;
  }

  #entete[data-flottant="true"]:not(.est-opaque) .entete-bouton {
    border-color: rgb(255 255 255 / 0.35);
    color: #fff;
  }

  #entete[data-flottant="true"]:not(.est-opaque) .entete-bouton:hover {
    background-color: rgb(255 255 255 / 0.12);
  }

  #entete[data-flottant="true"]:not(.est-opaque) .entete-langues {
    border-color: rgb(255 255 255 / 0.3);
  }

  #entete[data-flottant="true"]:not(.est-opaque) .entete-langue {
    color: rgb(255 255 255 / 0.75);
  }

  #entete[data-flottant="true"]:not(.est-opaque)
    .entete-langue[data-langue-active="true"] {
    background-color: rgb(255 255 255 / 0.18);
    color: #fff;
  }

  /* Barre reposée sur le fond de page. */
  #entete.est-opaque,
  #entete[data-flottant="false"] {
    background-color: rgb(255 255 255 / 0.92);
    border-bottom: 1px solid var(--color-bordure);
    backdrop-filter: blur(12px);
  }

  #entete.est-opaque .entete-titre,
  #entete[data-flottant="false"] .entete-titre {
    color: var(--color-ist-600);
  }

  #entete.est-opaque .entete-sous-titre,
  #entete[data-flottant="false"] .entete-sous-titre {
    color: var(--color-encre-douce);
  }

  #entete.est-opaque .entete-bouton,
  #entete[data-flottant="false"] .entete-bouton {
    border-color: var(--color-ist-200);
    color: var(--color-ist-600);
  }

  #entete.est-opaque .entete-bouton:hover,
  #entete[data-flottant="false"] .entete-bouton:hover {
    background-color: var(--color-ist-50);
  }

  #entete.est-opaque .entete-langues,
  #entete[data-flottant="false"] .entete-langues {
    border-color: var(--color-bordure);
  }

  #entete.est-opaque .entete-langue,
  #entete[data-flottant="false"] .entete-langue {
    color: var(--color-encre-douce);
  }

  #entete.est-opaque .entete-langue[data-langue-active="true"],
  #entete[data-flottant="false"] .entete-langue[data-langue-active="true"] {
    background-color: var(--color-ist-600);
    color: #fff;
  }
</style>

<script>
  const entete = document.getElementById("entete");

  // Transparence tant que le diaporama occupe le haut de l'écran.
  if (entete?.dataset.flottant === "true") {
    const hauteurBarre = entete.offsetHeight;
    const scene = document.getElementById("diaporama");

    const evaluer = () => {
      const limite = scene
        ? scene.offsetTop + scene.offsetHeight - hauteurBarre * 1.5
        : hauteurBarre;
      entete.classList.toggle("est-opaque", window.scrollY > limite);
    };

    evaluer();
    window.addEventListener("scroll", evaluer, { passive: true });
    window.addEventListener("resize", evaluer);
  }

  const panneauRacine = document.getElementById("menu-principal");
  const panneau = document.getElementById("menu-panneau");
  const ouvrir = document.getElementById("menu-ouvrir");
  const fermer = document.getElementById("menu-fermer");
  const fond = document.getElementById("menu-fond");

  const ouvrirMenu = () => {
    panneauRacine?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    ouvrir?.setAttribute("aria-expanded", "true");
    // setTimeout plutot que requestAnimationFrame : ce dernier est suspendu
    // quand l'onglet n'est pas visible, le panneau resterait hors ecran.
    setTimeout(() => panneau?.classList.remove("translate-x-full"), 10);
    fermer?.focus();
  };

  const fermerMenu = () => {
    panneau?.classList.add("translate-x-full");
    document.body.style.overflow = "";
    ouvrir?.setAttribute("aria-expanded", "false");
    setTimeout(() => panneauRacine?.classList.add("hidden"), 300);
    ouvrir?.focus();
  };

  ouvrir?.addEventListener("click", ouvrirMenu);
  fermer?.addEventListener("click", fermerMenu);
  fond?.addEventListener("click", fermerMenu);
  document.addEventListener("keydown", (evenement) => {
    if (evenement.key === "Escape" && !panneauRacine?.classList.contains("hidden")) {
      fermerMenu();
    }
  });
</script>
