---
// Grille de photographies avec légendes et agrandissement au clic.
const { photos } = Astro.props;
---

<ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    photos.map((photo) => (
      <li>
        <figure class="h-full overflow-hidden rounded-xl border border-slate-200 bg-white">
          <button
            type="button"
            class="galerie-vignette block w-full"
            data-src={`/images/actions/${photo.src}.webp`}
            data-legende={photo.legende}
          >
            <img
              src={`/images/actions/${photo.src}.webp`}
              alt={photo.legende}
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full cursor-zoom-in object-cover transition duration-300 hover:scale-105"
            />
          </button>
          <figcaption class="px-4 py-3 text-sm leading-snug text-slate-600">
            {photo.legende}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
