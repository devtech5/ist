---
import { contact } from "../data/site.js";
import { t } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;
const libelle = t(ui.general.whatsapp, lang);
const message =
  lang === "fr"
    ? "Bonjour, je vous contacte depuis le site de l'ONG IST."
    : "Hello, I am contacting you from the IST website.";
const url = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(message)}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  aria-label={libelle}
  class="group fixed bottom-5 right-5 z-40 flex items-center gap-3 rounded-full bg-[#25D366] py-3.5 pl-3.5 pr-4 text-white shadow-lg transition hover:bg-[#1da851] hover:shadow-xl sm:bottom-7 sm:right-7"
>
  <svg
    class="h-6 w-6 shrink-0"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"
    ></path>
    <path
      d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.46 3.44 1.32 4.94L2 22l5.35-1.4a9.82 9.82 0 0 0 4.69 1.19h.01c5.43 0 9.85-4.42 9.85-9.86A9.79 9.79 0 0 0 19 4.87 9.79 9.79 0 0 0 12.04 2Zm0 17.98h-.01a8.2 8.2 0 0 1-4.16-1.14l-.3-.18-3.09.81.83-3.02-.2-.31a8.15 8.15 0 0 1-1.25-4.36c0-4.52 3.68-8.2 8.19-8.2a8.14 8.14 0 0 1 5.79 2.4 8.13 8.13 0 0 1 2.4 5.8c0 4.52-3.68 8.2-8.2 8.2Z"
    ></path>
  </svg>

  <!-- Le libellé n'apparaît qu'au survol sur grand écran, pour ne pas masquer
       le contenu sur mobile. -->
  <span
    class="hidden max-w-0 overflow-hidden whitespace-nowrap text-sm font-semibold transition-all duration-300 group-hover:max-w-xs lg:inline"
  >
    WhatsApp
  </span>
</a>
