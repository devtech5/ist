---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Whatsapp from "../components/Whatsapp.astro";
import { site } from "../data/site.js";
import { t, langues, equivalent, langueParDefaut } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { titre, description, lang = langueParDefaut, flottant = false } =
  Astro.props;

const descriptionFinale = description ?? t(site.description, lang);
const titreComplet = titre
  ? `${titre} — ${site.sigle}`
  : `${site.sigle} — ${site.nom}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={descriptionFinale} />
    <link rel="icon" href="/images/logo-ist.png" type="image/png" />
    <meta name="theme-color" content="#0b4ea2" />

    {
      langues.map((code) => (
        <link rel="alternate" hreflang={code} href={equivalent(Astro.url, code)} />
      ))
    }

    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={descriptionFinale} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "fr" ? "fr_CI" : "en_GB"} />
    <meta property="og:image" content="/images/banniere-ist.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Marque la page comme scriptée : sans cette classe, les blocs animés
      // restent visibles, donc une panne de JavaScript ne masque aucun contenu.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="bg-white font-sans text-slate-700 antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ist-600 focus:px-5 focus:py-2.5 focus:text-white"
      >{t(ui.general.allerAuContenu, lang)}</a
    >

    <div
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent"
      aria-hidden="true"
    >
      <div id="progression" class="h-full w-full bg-ist-teal"></div>
    </div>

    <Header lang={lang} flottant={flottant} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
    <Whatsapp lang={lang} />

    <script>
      // GSAP et ScrollTrigger pilotent les apparitions, les compteurs et la
      // parallaxe. En cas d'échec du chargement, tout est révélé d'un coup.
      import("../scripts/animations.js").catch(() => {
        document.documentElement.classList.add("sans-gsap");
        document
          .querySelectorAll("[data-reveal]")
          .forEach((bloc) => bloc.classList.add("revele"));
      });

      // Filet de sécurité : si un déclencheur ne se déclenche jamais (onglet en
      // arrière-plan au chargement), tout devient visible au bout de trois
      // secondes.
      setTimeout(() => {
        document
          .querySelectorAll("[data-reveal]:not(.revele)")
          .forEach((bloc) => bloc.classList.add("revele"));
      }, 3000);
    </script>
  </body>
</html>
