---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.js";

const { titre, description = site.description } = Astro.props;
const titreComplet = titre ? `${titre} — ONG ${site.sigle}` : `ONG ${site.sigle} — ${site.nom}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/logo-ist.png" type="image/png" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CI" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white font-sans text-slate-700 antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ist-blue focus:px-4 focus:py-2 focus:text-white"
      >Aller au contenu</a
    >
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
