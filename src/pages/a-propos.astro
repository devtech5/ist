---
import Base from "../layouts/Base.astro";
import {
  site,
  vision,
  missions,
  agrements,
  distinctions,
  reseauxMembre,
  personnel,
  zones,
  materiel,
} from "../data/site.js";

const effectifTotal = personnel.reduce((somme, ligne) => somme + ligne.total, 0);
---

<Base
  titre="À propos"
  description={`Histoire, vision, missions, équipe et agréments de l'ONG ${site.sigle}, créée le ${site.creation} à San-Pédro.`}
>
  <section class="bg-ist-blue py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">À propos</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-50">
        {site.baseline}, créée le {site.creation} à San-Pédro.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl bg-ist-blue-light p-8">
        <h2 class="font-display text-2xl font-bold text-ist-blue">Notre vision</h2>
        <p class="mt-4 text-lg leading-relaxed">{vision}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-8">
        <h2 class="font-display text-2xl font-bold text-ist-blue">Notre devise</h2>
        <p class="mt-4 font-display text-3xl font-bold text-ist-red">
          {site.devise}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-bold text-ist-blue">Nos missions</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {
          missions.map((mission, index) => (
            <li class="rounded-2xl border border-slate-200 bg-white p-7">
              <span class="font-display text-3xl font-bold text-ist-teal">
                0{index + 1}
              </span>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{mission}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-3xl font-bold text-ist-blue">
      Notre équipe
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed">
      L'ONG {site.sigle} s'appuie sur un personnel qualifié de {effectifTotal}
      membres : médecins, assistants médicaux, psychologue, sages-femmes,
      infirmiers, aides-soignants, relais communautaires, bénévoles et personnel
      administratif.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[520px] border-collapse text-left text-sm">
        <thead>
          <tr class="bg-ist-blue text-white">
            <th class="px-4 py-3 font-semibold">Fonction</th>
            <th class="px-4 py-3 font-semibold">Total</th>
            <th class="px-4 py-3 font-semibold">Hommes</th>
            <th class="px-4 py-3 font-semibold">Femmes</th>
          </tr>
        </thead>
        <tbody>
          {
            personnel.map((ligne, index) => (
              <tr class={index % 2 === 1 ? "bg-slate-50" : ""}>
                <td class="px-4 py-3 font-medium text-slate-800">{ligne.fonction}</td>
                <td class="px-4 py-3">{ligne.total}</td>
                <td class="px-4 py-3">{ligne.hommes}</td>
                <td class="px-4 py-3">{ligne.femmes}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="bg-ist-blue py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-bold">Distinctions</h2>
      <p class="mt-4 max-w-3xl text-blue-50">
        Le travail de médiation et de santé communautaire conduit par le
        président de l'ONG a été distingué par les autorités nationales et par
        des organisations internationales.
      </p>
      <ul class="mt-8 grid gap-5 md:grid-cols-2">
        {
          distinctions.map((distinction) => (
            <li class="rounded-xl bg-white/10 p-6">
              <p class="font-display font-semibold">{distinction.intitule}</p>
              <p class="mt-2 text-sm text-blue-100">{distinction.decerne}</p>
              {distinction.date && (
                <p class="mt-1 text-sm text-blue-200">{distinction.date}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-bold text-ist-blue">
        Nos zones d'intervention
      </h2>
      <p class="mt-4 max-w-3xl leading-relaxed">
        Quarante antennes réparties sur le territoire national, dont plusieurs
        installées dans des zones de silence sanitaire à la demande des
        communautés locales.
      </p>
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          zones.map((zone) => (
            <li class="rounded-full border border-ist-blue/20 bg-white px-5 py-2 text-sm font-medium text-ist-blue">
              {zone}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold text-ist-blue">
          Existence légale
        </h2>
        <ul class="mt-6 space-y-4">
          {
            agrements.map((agrement) => (
              <li class="border-l-4 border-ist-teal pl-4">
                <p class="font-medium text-slate-800">{agrement.intitule}</p>
                <p class="text-sm text-slate-500">{agrement.date}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-3xl font-bold text-ist-blue">
          Réseaux et moyens
        </h2>
        <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-slate-500">
          Membre de
        </p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            reseauxMembre.map((reseau) => (
              <li class="rounded-full bg-ist-blue-light px-4 py-1.5 text-sm font-medium text-ist-blue">
                {reseau}
              </li>
            ))
          }
        </ul>

        <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-slate-500">
          Moyens matériels
        </p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
          {materiel.map((element) => <li>— {element}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
