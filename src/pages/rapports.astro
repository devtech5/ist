---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { bilans, agrements, site, contact } from "../data/site.js";

const rapports = (await getCollection("rapports")).sort(
  (a, b) => b.data.annee - a.data.annee
);

const fcfa = (montant) => `${montant.toLocaleString("fr-FR")} FCFA`;

const totaux = bilans.reduce(
  (cumul, bilan) => ({
    budget: cumul.budget + bilan.budget,
    fondsPropres: cumul.fondsPropres + bilan.fondsPropres,
    subvention: cumul.subvention + bilan.subvention,
  }),
  { budget: 0, fondsPropres: 0, subvention: 0 }
);
---

<Base
  titre="Rapports"
  description={`Rapports annuels, bilans financiers et documents officiels de l'ONG ${site.sigle}.`}
>
  <section class="bg-ist-blue py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Rapports</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-50">
        Nos rapports annuels sont consultables et téléchargeables librement.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-3xl font-bold text-ist-blue">
      Rapports annuels
    </h2>

    {
      rapports.length === 0 ? (
        <p class="mt-8 rounded-2xl bg-slate-50 p-10 text-center text-slate-600">
          Aucun rapport publié pour le moment.
        </p>
      ) : (
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {rapports.map((rapport) => {
            const contenu = (
              <>
                {rapport.data.couverture ? (
                  <img
                    src={rapport.data.couverture}
                    alt={`Couverture du ${rapport.data.titre}`}
                    loading="lazy"
                    class="aspect-3/4 w-full rounded-lg object-cover shadow-md"
                  />
                ) : (
                  <div class="flex aspect-3/4 w-full flex-col items-center justify-center rounded-lg bg-ist-blue text-white shadow-md">
                    <span class="font-display text-sm uppercase tracking-widest text-blue-200">
                      Rapport d'activité
                    </span>
                    <span class="mt-2 font-display text-6xl font-bold">
                      {rapport.data.annee}
                    </span>
                    <span class="mt-4 text-sm text-blue-100">{site.sigle}</span>
                  </div>
                )}
              </>
            );

            return (
              <li>
                {rapport.data.fichier && !rapport.data.exemple ? (
                  <a
                    href={rapport.data.fichier}
                    target="_blank"
                    rel="noopener"
                    class="group block transition hover:-translate-y-1"
                  >
                    <div class="overflow-hidden rounded-xl">{contenu}</div>
                    <p class="mt-4 text-center font-display font-semibold text-ist-blue group-hover:text-ist-red">
                      {rapport.data.titre}
                    </p>
                    <p class="mt-1 text-center text-sm text-slate-500">
                      Consulter le PDF
                    </p>
                  </a>
                ) : (
                  <div class="opacity-50">
                    <div class="overflow-hidden rounded-xl grayscale">{contenu}</div>
                    <p class="mt-4 text-center font-display font-semibold text-slate-600">
                      {rapport.data.titre}
                    </p>
                    <p class="mt-1 text-center text-sm text-slate-500">
                      {rapport.data.exemple
                        ? "Exemple de présentation — à remplacer"
                        : "Bientôt disponible"}
                    </p>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    <p class="mt-10 text-sm leading-relaxed text-slate-600">
      Les rapports détaillés par projet sont également consultables au siège de
      l'ONG et transmis sur demande aux partenaires, bailleurs et institutions
      publiques.
      <a
        class="font-medium text-ist-blue hover:underline"
        href={`mailto:${contact.email}?subject=${encodeURIComponent("Demande de rapport d'activité")}`}
        >Faire une demande</a
      >.
    </p>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-bold text-ist-blue">
        Bilan financier
      </h2>
      <p class="mt-4 max-w-3xl leading-relaxed">
        Répartition entre fonds propres et subventions des bailleurs sur les
        exercices documentés.
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-ist-blue text-white">
              <th class="px-4 py-3 font-semibold">Exercice</th>
              <th class="px-4 py-3 font-semibold">Budget exécuté</th>
              <th class="px-4 py-3 font-semibold">Fonds propres</th>
              <th class="px-4 py-3 font-semibold">Subvention</th>
              <th class="px-4 py-3 font-semibold">Bailleur</th>
            </tr>
          </thead>
          <tbody>
            {
              bilans.map((bilan, index) => (
                <tr class={index % 2 === 1 ? "bg-white" : "bg-slate-100/60"}>
                  <td class="px-4 py-3 font-medium text-slate-800">{bilan.annee}</td>
                  <td class="px-4 py-3 whitespace-nowrap">{fcfa(bilan.budget)}</td>
                  <td class="px-4 py-3 whitespace-nowrap">{fcfa(bilan.fondsPropres)}</td>
                  <td class="px-4 py-3 whitespace-nowrap">{fcfa(bilan.subvention)}</td>
                  <td class="px-4 py-3">{bilan.bailleur}</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="bg-ist-blue-light font-semibold text-ist-blue">
              <td class="px-4 py-3">Total</td>
              <td class="px-4 py-3 whitespace-nowrap">{fcfa(totaux.budget)}</td>
              <td class="px-4 py-3 whitespace-nowrap">{fcfa(totaux.fondsPropres)}</td>
              <td class="px-4 py-3 whitespace-nowrap">{fcfa(totaux.subvention)}</td>
              <td class="px-4 py-3"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-3xl font-bold text-ist-blue">
      Documents officiels
    </h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {
        agrements.map((agrement) => (
          <li class="rounded-xl border border-slate-200 p-6">
            <p class="font-medium text-slate-800">{agrement.intitule}</p>
            <p class="mt-1 text-sm text-slate-500">{agrement.date}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
