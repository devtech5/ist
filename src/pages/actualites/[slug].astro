---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const articles = await getCollection("actualites");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const dateLisible = article.data.date.toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base titre={article.data.titre} description={article.data.chapeau}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href="/actualites/"
      class="text-sm font-semibold text-ist-red transition hover:text-red-700"
      >← Toutes les actualités</a
    >

    <p class="mt-8 text-xs font-semibold uppercase tracking-wider text-ist-teal">
      {dateLisible}{article.data.lieu ? ` — ${article.data.lieu}` : ""}
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold leading-tight text-ist-blue sm:text-4xl">
      {article.data.titre}
    </h1>
    <p class="mt-5 border-l-4 border-ist-teal pl-5 text-lg leading-relaxed text-slate-600">
      {article.data.chapeau}
    </p>

    <div class="article mt-10">
      <Content />
    </div>
  </article>
</Base>

<style>
  .article :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ist-blue);
  }
  .article :global(p) {
    margin-top: 1.25rem;
    line-height: 1.8;
  }
  .article :global(ul) {
    margin-top: 1.25rem;
    list-style: disc;
    padding-left: 1.5rem;
  }
  .article :global(li) {
    margin-top: 0.5rem;
  }
  .article :global(strong) {
    color: var(--color-ist-blue);
  }
</style>
