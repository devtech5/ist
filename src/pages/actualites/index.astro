---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site.js";

const articles = (await getCollection("actualites")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formaterDate = (date) =>
  date.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Base
  titre="Actualités"
  description={`Campagnes, dépistages et interventions de terrain de l'ONG ${site.sigle}.`}
>
  <section class="bg-ist-blue py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Actualités</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-50">
        Campagnes, dépistages, formations et interventions de terrain.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    {
      articles.length === 0 ? (
        <p class="rounded-2xl bg-slate-50 p-10 text-center text-slate-600">
          Aucune actualité publiée pour le moment.
        </p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <article class="flex flex-col rounded-2xl border border-slate-200 p-7 transition hover:border-ist-blue hover:shadow-lg">
              <p class="text-xs font-semibold uppercase tracking-wider text-ist-teal">
                {formaterDate(article.data.date)}
              </p>
              <h2 class="mt-3 font-display text-lg font-bold text-slate-900">
                {article.data.titre}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {article.data.chapeau}
              </p>
              <a
                href={`/actualites/${article.id}/`}
                class="mt-auto pt-5 font-display text-sm font-semibold text-ist-red transition hover:text-red-700"
              >
                Lire l'article →
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Base>
