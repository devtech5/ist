---
import Vue from "../../../views/RealisationDetail.astro";
import { campagnes } from "../../../data/terrain.js";

export function getStaticPaths() {
  return campagnes.map((campagne, index) => ({
    params: { slug: campagne.slug },
    props: {
      campagne,
      precedente: campagnes[index - 1] ?? null,
      suivante: campagnes[index + 1] ?? null,
    },
  }));
}

const { campagne, precedente, suivante } = Astro.props;
---

<Vue
  lang="en"
  campagne={campagne}
  precedente={precedente}
  suivante={suivante}
/>
