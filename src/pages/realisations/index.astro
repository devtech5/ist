---
import Base from "../../layouts/Base.astro";
import { domaines, site, cta } from "../../data/site.js";
import { campagnes } from "../../data/terrain.js";

const filtres = [
  { slug: "tous", titre: "Toutes", total: campagnes.length },
  ...domaines.map((domaine) => ({
    slug: domaine.slug,
    titre: domaine.titre,
    total: campagnes.filter((campagne) => campagne.domaine === domaine.slug).length,
  })),
];

const nomDomaine = (slug) =>
  domaines.find((domaine) => domaine.slug === slug)?.titre ?? "";
---

<Base
  titre="Nos réalisations"
  description={`Les réalisations de terrain de l'ONG ${site.sigle} : santé, social et développement, cohésion sociale.`}
>
  <section class="bg-ist-blue py-20 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="max-w-3xl font-display text-4xl font-bold leading-tight sm:text-5xl">
        Des actions menées, des résultats mesurés
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-blue-50">
        Chaque réalisation répond à un besoin précis des populations. Voici
        comment nous y avons répondu.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap gap-3" role="group" aria-label="Filtrer par domaine">
      {
        filtres.map((filtre, index) => (
          <button
            type="button"
            class:list={[
              "filtre rounded-full border px-5 py-2.5 text-sm font-semibold transition",
              index === 0
                ? "border-ist-blue bg-ist-blue text-white"
                : "border-slate-300 bg-white text-slate-600 hover:border-ist-blue hover:text-ist-blue",
            ]}
            data-filtre={filtre.slug}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {filtre.titre}
            <span class="ml-1.5 opacity-70">({filtre.total})</span>
          </button>
        ))
      }
    </div>

    <ul id="grille" class="mt-10 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {
        campagnes.map((campagne) => (
          <li class="carte" data-domaine={campagne.domaine}>
            <a
              href={`/realisations/${campagne.slug}/`}
              class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-ist-blue hover:shadow-xl"
            >
              <div class="relative overflow-hidden">
                <img
                  src={`/images/actions/${campagne.photos[0].src}.webp`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="aspect-16/10 w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ist-blue">
                  {nomDomaine(campagne.domaine)}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-ist-teal">
                  {campagne.periode}
                </p>
                <h2 class="mt-2 font-display text-lg font-bold leading-snug text-slate-900">
                  {campagne.titre}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">
                  {campagne.extrait}
                </p>
                <p class="mt-4 text-sm font-medium text-slate-500">
                  {campagne.photos.length} photographies
                </p>
                <span class="mt-auto pt-5 font-display text-sm font-semibold text-ist-red">
                  Lire la réalisation →
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p id="aucun-resultat" class="mt-10 hidden text-center text-slate-500">
      Aucune réalisation dans ce domaine.
    </p>
  </section>

  <section class="bg-ist-blue py-16 text-white">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center sm:px-6"
    >
      <h2 class="font-display text-3xl font-bold">
        La prochaine réalisation dépend de vous
      </h2>
      <p class="max-w-2xl text-blue-50">
        Chaque contribution finance des soins, des campagnes de prévention et la
        formation de jeunes dans les zones les plus enclavées.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={cta.href}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold transition hover:bg-red-700"
          >{cta.label}</a
        >
        <a
          href="/contact/"
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold transition hover:bg-white hover:text-ist-blue"
          >Devenir bénévole ou partenaire</a
        >
      </div>
    </div>
  </section>
</Base>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>(".filtre");
  const cartes = document.querySelectorAll<HTMLElement>(".carte");
  const messageVide = document.getElementById("aucun-resultat");

  const actif = ["border-ist-blue", "bg-ist-blue", "text-white"];
  const inactif = [
    "border-slate-300",
    "bg-white",
    "text-slate-600",
    "hover:border-ist-blue",
    "hover:text-ist-blue",
  ];

  const appliquer = (choix: string | undefined) => {
    boutons.forEach((autre) => {
      const estChoisi = autre.dataset.filtre === choix;
      autre.setAttribute("aria-pressed", String(estChoisi));
      autre.classList.remove(...(estChoisi ? inactif : actif));
      autre.classList.add(...(estChoisi ? actif : inactif));
    });

    let visibles = 0;
    cartes.forEach((carte) => {
      const garder = choix === "tous" || carte.dataset.domaine === choix;
      carte.classList.toggle("hidden", !garder);
      if (garder) visibles += 1;
    });

    messageVide?.classList.toggle("hidden", visibles > 0);
  };

  // Un lien du type /realisations/#sante arrive avec le filtre deja choisi.
  const depuisAncre = window.location.hash.replace("#", "");
  if (depuisAncre && [...boutons].some((b) => b.dataset.filtre === depuisAncre)) {
    appliquer(depuisAncre);
  }

  boutons.forEach((bouton) => {
    bouton.addEventListener("click", () => appliquer(bouton.dataset.filtre));
  });
</script>
