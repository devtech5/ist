---
import Base from "../layouts/Base.astro";
import { contact, site } from "../data/site.js";

// TODO client : remplacer par les coordonnées réelles validées par le conseil
// d'administration. Tant que ces valeurs sont des exemples, la page indique
// clairement que les moyens de paiement ne sont pas encore actifs.
const moyensPaiement = [
  { nom: "Orange Money", numero: "À communiquer", actif: false },
  { nom: "MTN MoMo", numero: "À communiquer", actif: false },
  { nom: "Moov Money", numero: "À communiquer", actif: false },
  { nom: "Wave", numero: "À communiquer", actif: false },
];

const typesDon = [
  {
    titre: "Don financier",
    texte:
      "Une contribution ponctuelle ou régulière, affectée aux campagnes de sensibilisation, aux soins et à la formation.",
  },
  {
    titre: "Don en nature",
    texte:
      "Médicaments, matériel médical, équipements informatiques, vivres et non-vivres pour les antennes et les familles accompagnées.",
  },
  {
    titre: "Don de compétences",
    texte:
      "Personnel de santé, formateurs et bénévoles souhaitant appuyer nos interventions sur le terrain.",
  },
];
---

<Base
  titre="Faire un don"
  description={`Soutenir l'ONG ${site.sigle} : dons financiers, dons en nature et bénévolat.`}
>
  <section class="bg-ist-red py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Faire un don</h1>
      <p class="mt-4 max-w-2xl text-lg text-red-50">
        Votre contribution finance des soins, des campagnes de prévention et la
        formation de jeunes dans les zones les plus enclavées de Côte d'Ivoire.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-3xl font-bold text-ist-blue">
      Trois façons de nous soutenir
    </h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        typesDon.map((type) => (
          <div class="rounded-2xl border border-slate-200 p-7">
            <h3 class="font-display text-lg font-bold text-ist-blue">
              {type.titre}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{type.texte}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-bold text-ist-blue">
        Moyens de paiement
      </h2>

      <div
        class="mt-6 rounded-xl border-l-4 border-amber-500 bg-amber-50 p-5 text-sm text-amber-900"
      >
        <strong>Coordonnées en attente de validation.</strong> Les numéros
        ci-dessous seront activés dès leur confirmation par le conseil
        d'administration de l'ONG. En attendant, contactez directement le siège
        pour organiser votre don.
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          moyensPaiement.map((moyen) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="font-display font-bold text-ist-blue">{moyen.nom}</p>
              <p class="mt-2 text-sm text-slate-500">{moyen.numero}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-sm leading-relaxed text-slate-600">
        Pour un virement bancaire ou un don institutionnel, écrivez à
        <a class="font-medium text-ist-blue hover:underline" href={`mailto:${contact.email}`}
          >{contact.email}</a
        > ou appelez le
        <a class="font-medium text-ist-blue hover:underline" href={`tel:${contact.telephoneLien}`}
          >{contact.telephone}</a
        >. Les coordonnées bancaires sont transmises directement par le siège,
        après vérification.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="rounded-2xl bg-ist-blue-light p-10">
      <h2 class="font-display text-2xl font-bold text-ist-blue">
        Notre engagement de transparence
      </h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-slate-700">
        Chaque exercice fait l'objet d'un bilan financier distinguant fonds
        propres et subventions. Les rapports d'activité sont transmis aux
        bailleurs, aux autorités sanitaires et à toute personne qui en fait la
        demande.
      </p>
      <a
        href="/rapports/"
        class="mt-6 inline-block font-display font-semibold text-ist-red transition hover:text-red-700"
        >Consulter nos rapports →</a
      >
    </div>
  </section>
</Base>
