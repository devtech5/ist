---
import Base from "../layouts/Base.astro";
import { contact, site, zones } from "../data/site.js";
---

<Base
  titre="Contact"
  description={`Contacter l'ONG ${site.sigle} à San-Pédro : adresse, téléphone, courriel et formulaire.`}
>
  <section class="bg-ist-blue py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Contact</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-50">
        Une question, un partenariat, une candidature de bénévole ? Écrivez-nous.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold text-ist-blue">
          Siège national
        </h2>
        <ul class="mt-6 space-y-4 text-slate-700">
          <li>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
              Adresse
            </p>
            <p class="mt-1">{contact.siege}</p>
            <p>{contact.ville}</p>
          </li>
          <li>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
              Boîte postale
            </p>
            <p class="mt-1">{contact.boitePostale}</p>
          </li>
          <li>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
              Téléphone
            </p>
            <p class="mt-1">
              <a class="text-ist-blue hover:underline" href={`tel:${contact.telephoneLien}`}>
                {contact.telephone}
              </a>
            </p>
            <p>
              <a class="text-ist-blue hover:underline" href={`tel:${contact.mobileLien}`}>
                {contact.mobile}
              </a>
            </p>
          </li>
          <li>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
              Courriel
            </p>
            <p class="mt-1">
              <a class="text-ist-blue hover:underline" href={`mailto:${contact.email}`}>
                {contact.email}
              </a>
            </p>
          </li>
        </ul>

        <h2 class="mt-10 font-display text-2xl font-bold text-ist-blue">
          Nos antennes
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Quarante antennes réparties dans les localités suivantes. Pour joindre
          une antenne, passez par le siège.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            zones.map((zone) => (
              <li class="rounded-full bg-ist-blue-light px-4 py-1.5 text-sm text-ist-blue">
                {zone}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-200 p-8">
        <h2 class="font-display text-2xl font-bold text-ist-blue">
          Nous écrire
        </h2>

        <!--
          TODO technique : brancher l'action du formulaire sur un service
          d'envoi (Formspree, Web3Forms ou fonction serveur). En l'état, aucun
          message n'est transmis.
        -->
        <form class="mt-6 space-y-5" method="post" action="#">
          <div>
            <label class="block text-sm font-medium text-slate-700" for="nom"
              >Nom et prénoms</label
            >
            <input
              class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-ist-blue focus:outline-none focus:ring-2 focus:ring-ist-blue/20"
              id="nom"
              name="nom"
              type="text"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700" for="email"
              >Adresse électronique</label
            >
            <input
              class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-ist-blue focus:outline-none focus:ring-2 focus:ring-ist-blue/20"
              id="email"
              name="email"
              type="email"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700" for="objet"
              >Objet</label
            >
            <select
              class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 focus:border-ist-blue focus:outline-none focus:ring-2 focus:ring-ist-blue/20"
              id="objet"
              name="objet"
            >
              <option>Demande d'information</option>
              <option>Devenir bénévole</option>
              <option>Devenir partenaire</option>
              <option>Demande de rapport d'activité</option>
              <option>Autre</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700" for="message"
              >Message</label
            >
            <textarea
              class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-ist-blue focus:outline-none focus:ring-2 focus:ring-ist-blue/20"
              id="message"
              name="message"
              rows="5"
              required></textarea>
          </div>

          <button
            class="w-full rounded-full bg-ist-red px-6 py-3.5 font-display font-semibold text-white transition hover:bg-red-700"
            type="submit">Envoyer</button
          >
        </form>
      </div>
    </div>
  </section>
</Base>
