---
import Base from "../layouts/Base.astro";
import {
  site,
  chiffres,
  domaines,
  partenaires,
  vision,
  cta,
} from "../data/site.js";
import { campagnes } from "../data/terrain.js";

// Trois realisations mises en avant sur l'accueil, le detail vit dans sa page.
const enAvant = campagnes.filter((campagne) =>
  ["covid-savon", "depistage", "mediation"].includes(campagne.slug)
);

const formaterChiffre = (chiffre) =>
  chiffre.brut ? String(chiffre.valeur) : chiffre.valeur.toLocaleString("fr-FR");
---

<Base>
  <section class="relative overflow-hidden bg-ist-blue text-white">
    <div
      class="absolute inset-0 opacity-10"
      style="background-image:radial-gradient(circle at 20% 20%, white 1px, transparent 1px); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <p
        class="inline-block rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold"
      >
        Au service des populations depuis {site.anneeCreation}
      </p>
      <h1
        class="mt-6 max-w-3xl font-display text-4xl font-bold leading-tight sm:text-5xl md:text-6xl"
      >
        {site.nom}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-blue-50 sm:text-xl">
        {site.baseline} en Côte d'Ivoire. {vision}
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={cta.href}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold text-white transition hover:bg-red-700"
          >{cta.label}</a
        >
        <a
          href="/realisations/"
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold text-white transition hover:bg-white hover:text-ist-blue"
          >Découvrir nos réalisations</a
        >
      </div>
    </div>
  </section>

  <section class="border-b border-slate-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-14 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
      {
        chiffres.map((chiffre) => (
          <div class="rounded-2xl bg-ist-blue-light px-6 py-8 text-center">
            <p class="font-display text-4xl font-bold text-ist-blue">
              {formaterChiffre(chiffre)}
              {chiffre.suffixe ?? ""}
            </p>
            <p class="mt-2 text-sm font-medium text-slate-600">{chiffre.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold text-ist-blue sm:text-4xl">
          Qui sommes-nous ?
        </h2>
        <p class="mt-5 text-lg leading-relaxed">
          L'ONG {site.nom} ({site.sigle}) est une organisation d'assistance et
          de soins médicaux créée le {site.creation} à San-Pédro.
          Elle intervient dans seize zones sanitaires à travers quarante
          antennes, avec une équipe de médecins, d'assistants médicaux,
          d'infirmiers, de sages-femmes, d'aides-soignants et de relais
          communautaires.
        </p>
        <a
          href="/a-propos/"
          class="mt-7 inline-block font-display font-semibold text-ist-red transition hover:text-red-700"
          >Lire la suite →</a
        >
      </div>
      <img
        src="/images/banniere-ist.png"
        alt={`Bannière de l'ONG ${site.sigle}`}
        class="w-full rounded-2xl border border-slate-100 shadow-sm"
        loading="lazy"
      />
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-bold text-ist-blue sm:text-4xl">
        Nos domaines d'intervention
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          domaines.map((domaine) => (
            <a
              href={`/realisations/#${domaine.slug}`}
              class="group rounded-2xl border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-ist-blue hover:shadow-lg"
            >
              <h3 class="font-display text-xl font-bold text-ist-blue">
                {domaine.titre}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {domaine.resume}
              </p>
              <span class="mt-5 inline-block text-sm font-semibold text-ist-red">
                En savoir plus →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-display text-3xl font-bold text-ist-blue sm:text-4xl">
      Réalisations phares
    </h2>
    <div class="mt-10 grid gap-7 md:grid-cols-3">
      {
        enAvant.map((campagne) => (
          <a
            href={`/realisations/${campagne.slug}/`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-ist-blue hover:shadow-xl"
          >
            <img
              src={`/images/actions/${campagne.photos[0].src}.webp`}
              alt=""
              loading="lazy"
              decoding="async"
              class="aspect-16/10 w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-ist-teal">
                {campagne.periode}
              </p>
              <h3 class="mt-2 font-display text-lg font-bold leading-snug text-slate-900">
                {campagne.titre}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {campagne.resultat}
              </p>
              <span class="mt-auto pt-5 font-display text-sm font-semibold text-ist-red">
                Lire la réalisation →
              </span>
            </div>
          </a>
        ))
      }
    </div>
    <a
      href="/realisations/"
      class="mt-9 inline-block font-display font-semibold text-ist-red transition hover:text-red-700"
      >Voir toutes nos réalisations →</a
    >
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center font-display text-2xl font-bold text-ist-blue">
        Ils nous accompagnent
      </h2>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {
          partenaires.map((partenaire) => (
            <li class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-600">
              {partenaire}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-ist-blue py-16 text-white">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center sm:px-6"
    >
      <h2 class="font-display text-3xl font-bold">Soutenez notre action</h2>
      <p class="max-w-2xl text-blue-50">
        Chaque contribution finance des soins, des campagnes de sensibilisation
        et la formation de jeunes dans les zones les plus enclavées.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={cta.href}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold transition hover:bg-red-700"
          >{cta.label}</a
        >
        <a
          href="/contact/"
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold transition hover:bg-white hover:text-ist-blue"
          >Devenir bénévole ou partenaire</a
        >
      </div>
    </div>
  </section>
</Base>
