---
import Base from "../layouts/Base.astro";
import Defilement from "../components/ui/Defilement.astro";
import MotifPoints from "../components/ui/MotifPoints.astro";
import {
  site,
  chiffres,
  domaines,
  partenaires,
  vision,
  cta,
} from "../data/site.js";
import { campagnes } from "../data/terrain.js";
import { t, lien } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;

const enAvant = campagnes.filter((campagne) =>
  ["covid-savon", "depistage", "mediation"].includes(campagne.slug)
);

// Repère visuel par domaine, sans dépendance à une bibliothèque d'icônes.
const pictogrammes = {
  sante: "+",
  "social-developpement": "★",
  "cohesion-sociale": "◆",
};

const locale = lang === "fr" ? "fr-FR" : "en-GB";
---

<Base lang={lang}>
  <!-- Bandeau d'ouverture -->
  <section class="relative isolate overflow-hidden bg-ist-700">
    <div
      class="absolute inset-0 bg-gradient-to-br from-ist-800 via-ist-600 to-ist-500"
      aria-hidden="true"
    >
    </div>
    <div class="trame-ist absolute inset-0 opacity-60" aria-hidden="true"></div>
    <img
      src="/images/logo-ist.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -right-16 top-1/2 hidden w-[26rem] -translate-y-1/2 opacity-10 lg:block"
    />

    <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-32">
      <p
        class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white ring-1 ring-white/25"
      >
        <span class="h-2 w-2 rounded-full bg-ist-teal"></span>
        {t(ui.general.depuis, lang)}
        {site.anneeCreation}
      </p>

      <h1
        class="mt-7 max-w-3xl font-display text-4xl font-bold leading-[1.08] text-white sm:text-5xl md:text-6xl"
      >
        {site.nom}
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ist-100 sm:text-xl">
        {t(vision, lang)}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={lien(lang, cta.chemin)}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold text-white shadow-lg transition hover:bg-ist-red-dark hover:shadow-xl"
          >{t(ui.menu.don, lang)}</a
        >
        <a
          href={lien(lang, "realisations")}
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold text-white transition hover:bg-white hover:text-ist-700"
          >{t(ui.accueil.decouvrir, lang)}</a
        >
      </div>
    </div>
  </section>

  <!-- Chiffres clés -->
  <section class="relative isolate overflow-hidden bg-ist-900">
    <img
      src="/images/actions/communautaire-04.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      class="absolute inset-0 size-full origin-top scale-125 object-cover blur-[2px]"
    />
    <div class="absolute inset-0 bg-ist-900/78" aria-hidden="true"></div>
    <div class="trame-ist absolute inset-0 opacity-40" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <h2
        class="text-center font-display text-3xl font-bold text-white sm:text-4xl md:text-[2.75rem]"
        data-reveal="up"
      >
        {t(ui.accueil.chiffres, lang)}
      </h2>

      <dl class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
        {
          chiffres.map((chiffre, index) => (
            <div
              class="flex min-w-0 flex-col-reverse justify-end rounded-xl border border-white/25 bg-white/12 px-5 py-8 text-center shadow-carte backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-white/35 hover:bg-white/15 sm:px-6"
              data-reveal="up"
              data-reveal-delay={index * 70}
            >
              <dt class="mt-3 font-display text-xs font-semibold uppercase leading-snug tracking-[0.08em] text-white/85 sm:text-sm">
                {t(chiffre.label, lang)}
              </dt>
              <dd class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
                <span
                  data-compteur={chiffre.valeur}
                  data-suffixe={chiffre.suffixe ?? ""}
                  data-brut={chiffre.brut ? "true" : "false"}
                  class="tabular-nums"
                >
                  {chiffre.brut
                    ? String(chiffre.valeur)
                    : `${chiffre.valeur.toLocaleString(locale)}${chiffre.suffixe ?? ""}`}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Présentation -->
  <section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="surtitre" data-reveal="up">
          <span class="h-px w-8 bg-ist-600" aria-hidden="true"></span>
          {site.sigle}
        </p>
        <h2
          class="mt-5 font-display text-3xl font-semibold sm:text-4xl md:text-[2.75rem]"
          data-reveal="up"
          data-reveal-delay="80"
        >
          {t(ui.accueil.quiSommesNous, lang)}
        </h2>
        <p
          class="mt-6 text-lg leading-relaxed text-encre-douce"
          data-reveal="up"
          data-reveal-delay="140"
        >
          {t(site.presentation, lang)}
        </p>
        <p
          class="mt-6 border-l-2 border-ist-teal pl-5 text-lg leading-relaxed"
          data-reveal="up"
          data-reveal-delay="180"
        >
          {t(vision, lang)}
        </p>
        <a
          href={lien(lang, "a-propos")}
          class="mt-8 inline-flex items-center gap-2 font-display font-semibold text-ist-red transition hover:gap-3"
          data-reveal="up"
          data-reveal-delay="220"
          >{t(ui.general.lireLaSuite, lang)} <span aria-hidden="true">→</span></a
        >
      </div>

      <div
        class="relative overflow-hidden rounded-xl border border-bordure"
        data-reveal="zoom"
      >
        <img
          src="/images/banniere-ist.png"
          alt={`${site.sigle} — ${site.nom}`}
          class="w-full"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Domaines -->
  <section class="border-y border-bordure bg-voile/50 py-20 sm:py-24">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
      <p class="surtitre" data-reveal="up">
        <span class="h-px w-8 bg-ist-600" aria-hidden="true"></span>
        {t(ui.realisations.domaine, lang)}
      </p>
      <h2
        class="mt-5 max-w-3xl font-display text-3xl font-semibold sm:text-4xl md:text-[2.75rem]"
        data-reveal="up"
        data-reveal-delay="80"
      >
        {t(ui.accueil.domaines, lang)}
      </h2>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-xl border border-bordure bg-bordure md:grid-cols-3"
      >
        {
          domaines.map((domaine, index) => (
            <a
              href={`${lien(lang, "realisations")}#${domaine.slug}`}
              class="group flex flex-col bg-fond p-8 transition-colors duration-300 hover:bg-ist-50"
              data-reveal="up"
              data-reveal-delay={index * 90}
            >
              <span class="grid size-12 place-items-center rounded-md bg-ist-50 font-display text-lg font-semibold text-ist-600 transition-transform duration-300 group-hover:scale-110">
                {pictogrammes[domaine.slug]}
              </span>
              <h3 class="mt-6 font-display text-lg font-semibold leading-snug">
                {t(domaine.titre, lang)}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-encre-douce">
                {t(domaine.resume, lang)}
              </p>
              <span class="mt-6 font-display text-sm font-semibold text-ist-red">
                {t(ui.general.enSavoirPlus, lang)} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Réalisations phares -->
  <section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="surtitre" data-reveal="up">
          <span class="h-px w-8 bg-ist-600" aria-hidden="true"></span>
          {t(ui.menu.realisations, lang)}
        </p>
        <h2
          class="mt-5 font-display text-3xl font-semibold sm:text-4xl md:text-[2.75rem]"
          data-reveal="up"
          data-reveal-delay="80"
        >
          {t(ui.accueil.phares, lang)}
        </h2>
      </div>
      <a
        href={lien(lang, "realisations")}
        class="font-display font-semibold text-ist-red transition hover:text-ist-red-dark"
        data-reveal="up"
        data-reveal-delay="140"
        >{t(ui.accueil.voirTout, lang)} →</a
      >
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-3">
      {
        enAvant.map((campagne, index) => (
          <a
            href={lien(lang, `realisations/${campagne.slug}`)}
            class="group flex flex-col overflow-hidden rounded-xl border border-bordure bg-fond transition duration-300 hover:-translate-y-1 hover:shadow-carte-active"
            data-reveal="up"
            data-reveal-delay={index * 90}
          >
            <div class="overflow-hidden">
              <img
                src={campagne.photos[0].src}
                alt=""
                loading="lazy"
                decoding="async"
                class="aspect-16/10 w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="font-display text-xs font-medium uppercase tracking-[0.22em] text-ist-teal">
                {t(campagne.periode, lang)}
              </p>
              <h3 class="mt-3 font-display text-lg font-semibold leading-snug">
                {t(campagne.titre, lang)}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-encre-douce">
                {t(campagne.resultat, lang)}
              </p>
              <span class="mt-6 font-display text-sm font-semibold text-ist-red">
                {t(ui.realisations.lire, lang)} →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Partenaires -->
  <section class="border-y border-bordure bg-voile/40 py-16">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
      <p class="justify-center surtitre" data-reveal="up">
        <span class="h-px w-8 bg-ist-600" aria-hidden="true"></span>
        {t(ui.accueil.partenaires, lang)}
      </p>
    </div>

    <div class="mt-10" data-reveal="flou">
      <Defilement
        elements={partenaires.map((partenaire) => ({
          nom: t(partenaire.nom, lang),
          sigle: partenaire.sigle,
          logo: partenaire.logo,
        }))}
      />
    </div>
  </section>

  <!-- Appel à l'action -->
  <section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <div
      class="bordure-lumineuse relative isolate flex min-h-[22rem] items-center overflow-hidden rounded-xl bg-ist-800 px-6 py-20 text-white sm:min-h-[26rem] sm:px-12 sm:py-24"
      data-reveal="zoom"
    >
      <MotifPoints classe="text-white/25" />
      <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">
          {t(ui.accueil.soutenir, lang)}
        </h2>
        <p class="text-lg leading-relaxed text-ist-100">
          {t(ui.accueil.soutenirTexte, lang)}
        </p>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
          <a
            href={lien(lang, cta.chemin)}
            class="rounded-lg bg-ist-red px-7 py-3.5 font-display font-semibold transition hover:bg-ist-red-dark active:translate-y-px"
            >{t(ui.menu.don, lang)}</a
          >
          <a
            href={lien(lang, "contact")}
            class="rounded-lg border border-white/40 px-7 py-3.5 font-display font-semibold transition hover:bg-white hover:text-ist-800 active:translate-y-px"
            >{t(ui.accueil.benevole, lang)}</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>
