---
import Base from "../layouts/Base.astro";
import {
  site,
  chiffres,
  domaines,
  partenaires,
  vision,
  cta,
} from "../data/site.js";
import { campagnes } from "../data/terrain.js";
import { t, lien } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;

const enAvant = campagnes.filter((campagne) =>
  ["covid-savon", "depistage", "mediation"].includes(campagne.slug)
);

// Repère visuel par domaine, sans dépendance à une bibliothèque d'icônes.
const pictogrammes = {
  sante: "+",
  "social-developpement": "★",
  "cohesion-sociale": "◆",
};

const formaterChiffre = (chiffre) =>
  chiffre.brut
    ? String(chiffre.valeur)
    : chiffre.valeur.toLocaleString(lang === "fr" ? "fr-FR" : "en-GB");
---

<Base lang={lang}>
  <!-- Bandeau d'ouverture -->
  <section class="relative isolate overflow-hidden bg-ist-700">
    <div
      class="absolute inset-0 bg-gradient-to-br from-ist-800 via-ist-600 to-ist-500"
      aria-hidden="true"
    >
    </div>
    <div class="trame-ist absolute inset-0 opacity-60" aria-hidden="true"></div>
    <img
      src="/images/logo-ist.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -right-16 top-1/2 hidden w-[26rem] -translate-y-1/2 opacity-10 lg:block"
    />

    <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-32">
      <p
        class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white ring-1 ring-white/25"
      >
        <span class="h-2 w-2 rounded-full bg-ist-teal"></span>
        {t(ui.general.depuis, lang)}
        {site.anneeCreation}
      </p>

      <h1
        class="mt-7 max-w-3xl font-display text-4xl font-bold leading-[1.08] text-white sm:text-5xl md:text-6xl"
      >
        {site.nom}
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ist-100 sm:text-xl">
        {t(vision, lang)}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={lien(lang, cta.chemin)}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold text-white shadow-lg transition hover:bg-ist-red-dark hover:shadow-xl"
          >{t(ui.menu.don, lang)}</a
        >
        <a
          href={lien(lang, "realisations")}
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold text-white transition hover:bg-white hover:text-ist-700"
          >{t(ui.accueil.decouvrir, lang)}</a
        >
      </div>
    </div>
  </section>

  <!-- Chiffres clés, en chevauchement sur le bandeau -->
  <section class="relative z-10 -mt-12 px-4 sm:px-6">
    <div
      class="mx-auto grid max-w-6xl gap-px overflow-hidden rounded-2xl border border-ist-100 bg-ist-100 shadow-carte sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        chiffres.map((chiffre) => (
          <div class="bg-white px-6 py-8 text-center">
            <p class="font-display text-4xl font-bold text-ist-600">
              {formaterChiffre(chiffre)}
              {chiffre.suffixe ?? ""}
            </p>
            <p class="mt-2 text-sm font-medium text-slate-600">
              {t(chiffre.label, lang)}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Présentation -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="grid items-center gap-14 md:grid-cols-2">
      <div class="apparition">
        <p class="surtitre">{site.sigle}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ist-800 sm:text-4xl">
          {t(ui.accueil.quiSommesNous, lang)}
        </h2>
        <p class="mt-6 text-lg leading-relaxed">{t(site.presentation, lang)}</p>
        <a
          href={lien(lang, "a-propos")}
          class="mt-8 inline-flex items-center gap-2 font-display font-semibold text-ist-red transition hover:gap-3 hover:text-ist-red-dark"
          >{t(ui.general.lireLaSuite, lang)} <span aria-hidden="true">→</span></a
        >
      </div>
      <img
        src="/images/banniere-ist.png"
        alt={`${site.sigle} — ${site.nom}`}
        class="apparition w-full rounded-2xl border border-ist-100 shadow-carte"
        loading="lazy"
      />
    </div>
  </section>

  <!-- Domaines -->
  <section class="bg-ist-sand py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="surtitre">{t(ui.realisations.domaine, lang)}</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-ist-800 sm:text-4xl">
        {t(ui.accueil.domaines, lang)}
      </h2>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          domaines.map((domaine) => (
            <a
              href={`${lien(lang, "realisations")}#${domaine.slug}`}
              class="apparition group rounded-2xl border border-ist-100 bg-white p-8 transition hover:-translate-y-1 hover:border-ist-300 hover:shadow-carte-active"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-ist-50 font-display text-lg font-bold text-ist-600 transition group-hover:bg-ist-600 group-hover:text-white">
                {pictogrammes[domaine.slug]}
              </span>
              <h3 class="mt-5 font-display text-xl font-bold text-ist-800">
                {t(domaine.titre, lang)}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {t(domaine.resume, lang)}
              </p>
              <span class="mt-6 inline-block text-sm font-semibold text-ist-red">
                {t(ui.general.enSavoirPlus, lang)} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Réalisations phares -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="surtitre">{t(ui.menu.realisations, lang)}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ist-800 sm:text-4xl">
          {t(ui.accueil.phares, lang)}
        </h2>
      </div>
      <a
        href={lien(lang, "realisations")}
        class="font-display font-semibold text-ist-red transition hover:text-ist-red-dark"
        >{t(ui.accueil.voirTout, lang)} →</a
      >
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-3">
      {
        enAvant.map((campagne) => (
          <a
            href={lien(lang, `realisations/${campagne.slug}`)}
            class="apparition group flex flex-col overflow-hidden rounded-2xl border border-ist-100 bg-white shadow-carte transition hover:-translate-y-1 hover:shadow-carte-active"
          >
            <div class="overflow-hidden">
              <img
                src={`/images/actions/${campagne.photos[0].src}.webp`}
                alt=""
                loading="lazy"
                decoding="async"
                class="aspect-16/10 w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="surtitre">{t(campagne.periode, lang)}</p>
              <h3 class="mt-2.5 font-display text-lg font-bold leading-snug text-ist-800">
                {t(campagne.titre, lang)}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {t(campagne.resultat, lang)}
              </p>
              <span class="mt-auto pt-6 font-display text-sm font-semibold text-ist-red">
                {t(ui.realisations.lire, lang)} →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Partenaires -->
  <section class="bg-ist-sand py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center surtitre">{t(ui.accueil.partenaires, lang)}</h2>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {
          partenaires.map((partenaire) => (
            <li class="rounded-full border border-ist-100 bg-white px-5 py-2.5 text-sm font-medium text-slate-600">
              {t(partenaire, lang)}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Appel à l'action -->
  <section class="relative isolate overflow-hidden bg-ist-700 py-20 text-white">
    <div class="trame-ist absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center sm:px-6"
    >
      <h2 class="font-display text-3xl font-bold sm:text-4xl">
        {t(ui.accueil.soutenir, lang)}
      </h2>
      <p class="max-w-2xl text-lg text-ist-100">
        {t(ui.accueil.soutenirTexte, lang)}
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-4">
        <a
          href={lien(lang, cta.chemin)}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold shadow-lg transition hover:bg-ist-red-dark"
          >{t(ui.menu.don, lang)}</a
        >
        <a
          href={lien(lang, "contact")}
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold transition hover:bg-white hover:text-ist-700"
          >{t(ui.accueil.benevole, lang)}</a
        >
      </div>
    </div>
  </section>
</Base>
