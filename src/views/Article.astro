---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { t, lien } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { article, lang } = Astro.props;
const { Content } = await render(article);

const dateLisible = article.data.date.toLocaleDateString(
  lang === "fr" ? "fr-FR" : "en-GB",
  { day: "numeric", month: "long", year: "numeric" }
);
---

<Base lang={lang} titre={article.data.titre} description={article.data.chapeau}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href={lien(lang, "actualites")}
      class="text-sm font-semibold text-ist-red transition hover:text-ist-red-dark"
      >← {t(ui.actualites.retour, lang)}</a
    >

    <p class="mt-8 surtitre">
      {dateLisible}{article.data.lieu ? ` — ${article.data.lieu}` : ""}
    </p>
    <h1
      class="mt-3 font-display text-3xl font-semibold leading-tight text-ist-800 sm:text-4xl"
    >
      {article.data.titre}
    </h1>
    <p class="mt-6 border-l-4 border-ist-teal pl-5 text-lg leading-relaxed text-encre-douce">
      {article.data.chapeau}
    </p>

    <div class="article mt-10">
      <Content />
    </div>
  </article>
</Base>

<style>
  .article :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ist-700);
  }
  .article :global(p) {
    margin-top: 1.25rem;
    line-height: 1.8;
  }
  .article :global(ul) {
    margin-top: 1.25rem;
    list-style: disc;
    padding-left: 1.5rem;
  }
  .article :global(li) {
    margin-top: 0.5rem;
  }
  .article :global(strong) {
    color: var(--color-ist-700);
  }
</style>
