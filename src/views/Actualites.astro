---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { t, lien, langueParDefaut } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;

const articles = (await getCollection("actualites"))
  .filter((article) => (article.data.lang ?? langueParDefaut) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formaterDate = (date) =>
  date.toLocaleDateString(lang === "fr" ? "fr-FR" : "en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Base
  lang={lang}
  titre={t(ui.actualites.titre, lang)}
  description={t(ui.actualites.sousTitre, lang)}
>
  <section class="relative isolate overflow-hidden bg-ist-700 py-20 text-white">
    <div class="trame-ist absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">
        {t(ui.actualites.titre, lang)}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ist-100">
        {t(ui.actualites.sousTitre, lang)}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    {
      articles.length === 0 ? (
        <p class="rounded-2xl bg-ist-sand p-10 text-center text-slate-600">
          {t(ui.actualites.aucune, lang)}
        </p>
      ) : (
        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <article class="apparition flex flex-col rounded-2xl border border-ist-100 bg-white p-7 shadow-carte transition hover:-translate-y-1 hover:shadow-carte-active">
              <p class="surtitre">{formaterDate(article.data.date)}</p>
              <h2 class="mt-3 font-display text-lg font-bold leading-snug text-ist-800">
                {article.data.titre}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {article.data.chapeau}
              </p>
              <a
                href={lien(lang, `actualites/${article.data.cle}`)}
                class="mt-auto pt-6 font-display text-sm font-semibold text-ist-red"
              >
                {t(ui.actualites.lire, lang)} →
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Base>
