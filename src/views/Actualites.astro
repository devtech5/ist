---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EntetePage from "../components/EntetePage.astro";
import { t, lien, langueParDefaut } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;

const articles = (await getCollection("actualites"))
  .filter((article) => (article.data.lang ?? langueParDefaut) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formaterDate = (date) =>
  date.toLocaleDateString(lang === "fr" ? "fr-FR" : "en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Base
  lang={lang}
  titre={t(ui.actualites.titre, lang)}
  description={t(ui.actualites.sousTitre, lang)}
>
  <EntetePage
    lang={lang}
    titre={t(ui.actualites.titre, lang)}
    accroche={t(ui.actualites.sousTitre, lang)}
    image="/images/actions/depistage-06.webp"
    alt={t(ui.actualites.titre, lang)}
  />

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    {
      articles.length === 0 ? (
        <p class="rounded-xl bg-voile/50 p-10 text-center text-encre-douce">
          {t(ui.actualites.aucune, lang)}
        </p>
      ) : (
        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <article data-reveal="up" class="flex flex-col rounded-xl border border-bordure bg-white p-7 shadow-carte transition hover:-translate-y-1 hover:shadow-carte-active">
              <p class="surtitre">{formaterDate(article.data.date)}</p>
              <h2 class="mt-3 font-display text-lg font-semibold leading-snug text-ist-800">
                {article.data.titre}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-encre-douce">
                {article.data.chapeau}
              </p>
              <a
                href={lien(lang, `actualites/${article.data.cle}`)}
                class="mt-auto pt-6 font-display text-sm font-semibold text-ist-red"
              >
                {t(ui.actualites.lire, lang)} →
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Base>
