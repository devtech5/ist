---
import Base from "../layouts/Base.astro";
import EntetePage from "../components/EntetePage.astro";
import { contact } from "../data/site.js";
import { t, lien } from "../i18n/index.js";
import { ui, remplir } from "../i18n/ui.js";

const { lang } = Astro.props;

// TODO client : remplacer par les coordonnées réelles validées par le conseil
// d'administration. Tant que ces valeurs sont des exemples, la page indique
// clairement que les moyens de paiement ne sont pas encore actifs.
const moyensPaiement = ["Orange Money", "MTN MoMo", "Moov Money", "Wave"];

const typesDon = [
  {
    titre: { fr: "Don financier", en: "Financial gift" },
    texte: {
      fr: "Une contribution ponctuelle ou régulière, affectée aux campagnes de sensibilisation, aux soins et à la formation.",
      en: "A one-off or regular contribution, directed to awareness campaigns, medical care and training.",
    },
  },
  {
    titre: { fr: "Don en nature", en: "Gift in kind" },
    texte: {
      fr: "Médicaments, matériel médical, équipements informatiques, vivres et non-vivres pour les antennes et les familles accompagnées.",
      en: "Medicines, medical supplies, IT equipment, food and non-food items for our branches and the families we support.",
    },
  },
  {
    titre: { fr: "Don de compétences", en: "Gift of skills" },
    texte: {
      fr: "Personnel de santé, formateurs et bénévoles souhaitant appuyer nos interventions sur le terrain.",
      en: "Health professionals, trainers and volunteers willing to support our work in the field.",
    },
  },
];
---

<Base
  lang={lang}
  titre={t(ui.don.titre, lang)}
  description={t(ui.don.sousTitre, lang)}
>
  <EntetePage
    titre={t(ui.don.titre, lang)}
    accroche={t(ui.don.sousTitre, lang)}
    image="/images/actions/covid-savon-05.webp"
    alt={t(ui.don.titre, lang)}
  />

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-display text-3xl font-semibold text-ist-800">
      {t(ui.don.troisFacons, lang)}
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        typesDon.map((type) => (
          <div data-reveal="up" class="rounded-xl border border-bordure bg-fond p-8 shadow-carte">
            <h3 class="font-display text-lg font-semibold text-ist-700">
              {t(type.titre, lang)}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-encre-douce">
              {t(type.texte, lang)}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-voile/50 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-semibold text-ist-800">
        {t(ui.don.moyens, lang)}
      </h2>

      <div
        class="mt-7 rounded-xl border-l-4 border-amber-500 bg-amber-50 p-6 text-sm text-amber-900"
      >
        <strong>{t(ui.don.avertissement, lang)}</strong>
        {" "}{t(ui.don.avertissementTexte, lang)}
      </div>

      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          moyensPaiement.map((moyen) => (
            <div class="rounded-xl border border-bordure bg-white p-6 shadow-carte">
              <p class="font-display font-semibold text-ist-700">{moyen}</p>
              <p class="mt-2 text-sm text-encre-douce">{t(ui.don.aCommuniquer, lang)}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-9 max-w-3xl text-sm leading-relaxed text-encre-douce">
        <Fragment
          set:html={remplir(t(ui.don.virement, lang), {
            email: `<a class="font-medium text-ist-600 hover:underline" href="mailto:${contact.email}">${contact.email}</a>`,
            tel: `<a class="font-medium text-ist-600 hover:underline" href="tel:${contact.telephoneLien}">${contact.telephone}</a>`,
          })}
        />
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="rounded-xl bg-ist-50 p-10" data-reveal="zoom">
      <h2 class="font-display text-2xl font-semibold text-ist-800">
        {t(ui.don.transparence, lang)}
      </h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-encre">
        {t(ui.don.transparenceTexte, lang)}
      </p>
      <a
        href={lien(lang, "rapports")}
        class="mt-7 inline-flex items-center gap-2 font-display font-semibold text-ist-red transition hover:gap-3 hover:text-ist-red-dark"
        >{t(ui.don.consulterRapports, lang)} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</Base>
