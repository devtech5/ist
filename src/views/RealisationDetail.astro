---
import Base from "../layouts/Base.astro";
import Galerie from "../components/Galerie.astro";
import Lightbox from "../components/Lightbox.astro";
import { domaines } from "../data/site.js";
import { t, lien } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { campagne, precedente, suivante, lang } = Astro.props;

const domaine = domaines.find((d) => d.slug === campagne.domaine);
const [couverture, ...autresPhotos] = campagne.photos;
const legendeCouverture = t(couverture.legende, lang);
---

<Base
  lang={lang}
  titre={t(campagne.titre, lang)}
  description={t(campagne.extrait, lang)}
>
  <article>
    <header class="border-b border-bordure">
      <div class="mx-auto w-full max-w-4xl px-5 pb-12 pt-14 sm:px-8 sm:pt-16">
        <a
          href={lien(lang, "realisations")}
          class="inline-flex items-center gap-2 text-sm font-semibold text-ist-red transition hover:gap-3"
          >← {t(ui.realisations.retour, lang)}</a
        >

        <p class="mt-8 flex flex-wrap items-center gap-3 text-sm" data-reveal="up">
          <span class="rounded-md bg-ist-50 px-3.5 py-1 font-semibold text-ist-600">
            {t(domaine?.titre, lang)}
          </span>
          <span class="text-encre-douce">{t(campagne.periode, lang)}</span>
        </p>

        <h1
          class="mt-5 font-display text-3xl font-semibold sm:text-5xl"
          data-reveal="up"
          data-reveal-delay="80"
        >
          {t(campagne.titre, lang)}
        </h1>
        <p
          class="mt-5 max-w-2xl text-lg leading-relaxed text-encre-douce"
          data-reveal="up"
          data-reveal-delay="140"
        >
          {t(campagne.extrait, lang)}
        </p>
      </div>
    </header>

    <div class="mx-auto w-full max-w-4xl px-5 sm:px-8">
      <figure class="mt-10 overflow-hidden rounded-xl border border-bordure" data-reveal="zoom">
        <img
          src={couverture.src}
          alt={legendeCouverture}
          class="aspect-16/9 w-full object-cover"
          data-parallaxe
        />
      </figure>
      <p class="mt-3 text-center text-sm text-encre-douce">{legendeCouverture}</p>

      <dl class="mt-12 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl bg-ist-50 px-5 py-5">
          <dt class="surtitre">{t(ui.realisations.lieu, lang)}</dt>
          <dd class="mt-2 text-sm text-encre">{t(campagne.lieu, lang)}</dd>
        </div>
        <div class="rounded-xl bg-ist-50 px-5 py-5">
          <dt class="surtitre">{t(ui.realisations.resultat, lang)}</dt>
          <dd class="mt-2 text-sm text-encre">{t(campagne.resultat, lang)}</dd>
        </div>
        <div class="rounded-xl bg-voile px-5 py-5">
          <dt class="surtitre text-encre-douce">
            {t(ui.realisations.financement, lang)}
          </dt>
          <dd class="mt-2 text-sm text-encre">{t(campagne.financement, lang)}</dd>
        </div>
      </dl>

      <p class="mt-12 text-lg leading-relaxed text-encre">
        {t(campagne.texte, lang)}
      </p>

      {
        campagne.lien && (
          <a
            href={lien(lang, campagne.lien)}
            class="mt-7 inline-flex items-center gap-2 font-display font-semibold text-ist-red transition hover:gap-3 hover:text-ist-red-dark"
          >
            {t(ui.realisations.compteRendu, lang)} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    {
      autresPhotos.length > 0 && (
        <section class="mt-20 bg-voile/50 py-16">
          <div class="mx-auto max-w-6xl px-4 sm:px-6">
            <h2 class="font-display text-2xl font-semibold text-ist-800">
              {t(ui.realisations.enImages, lang)}
            </h2>
            <Galerie photos={autresPhotos} lang={lang} />
          </div>
        </section>
      )
    }

    <nav class="mx-auto mt-16 w-full max-w-4xl px-5 pb-24 sm:px-8">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          precedente ? (
            <a
              href={lien(lang, `realisations/${precedente.slug}`)}
              class="rounded-xl border border-bordure p-6 transition hover:border-ist-400 hover:shadow-carte"
            >
              <p class="surtitre text-encre-douce">
                {t(ui.realisations.precedente, lang)}
              </p>
              <p class="mt-2 font-display font-semibold text-ist-700">
                {t(precedente.titre, lang)}
              </p>
            </a>
          ) : (
            <span />
          )
        }
        {
          suivante && (
            <a
              href={lien(lang, `realisations/${suivante.slug}`)}
              class="rounded-xl border border-bordure p-6 text-right transition hover:border-ist-400 hover:shadow-carte sm:col-start-2"
            >
              <p class="surtitre text-encre-douce">
                {t(ui.realisations.suivante, lang)}
              </p>
              <p class="mt-2 font-display font-semibold text-ist-700">
                {t(suivante.titre, lang)}
              </p>
            </a>
          )
        }
      </div>
    </nav>
  </article>

  <Lightbox />
</Base>
