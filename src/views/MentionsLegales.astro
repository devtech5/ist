---
import Base from "../layouts/Base.astro";
import { site, contact, agrements } from "../data/site.js";
import { t } from "../i18n/index.js";
import { ui, remplir } from "../i18n/ui.js";

const { lang } = Astro.props;
const titreSection = "mt-12 font-display text-xl font-bold text-ist-700";
---

<Base lang={lang} titre={t(ui.legal.titre, lang)}>
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-ist-800 sm:text-4xl">
      {t(ui.legal.titre, lang)}
    </h1>

    <h2 class={titreSection}>{t(ui.legal.editeur, lang)}</h2>
    <p class="mt-3 leading-relaxed">
      {site.nom} ({site.sigle}) — {t(site.baseline, lang)}, {t(site.creation, lang)}.<br
      />
      {t(contact.siege, lang)} — {t(contact.ville, lang)}<br />
      {contact.boitePostale}<br />
      {t(ui.contact.telephone, lang)} : {contact.telephone} — {
        t(ui.contact.courriel, lang)
      } : {contact.email}
    </p>

    <h2 class={titreSection}>{t(ui.legal.statut, lang)}</h2>
    <ul class="mt-3 space-y-1 leading-relaxed">
      {
        agrements.map((agrement) => (
          <li>
            — {t(agrement.intitule, lang)}, {t(agrement.date, lang)}
          </li>
        ))
      }
    </ul>

    <h2 class={titreSection}>{t(ui.legal.hebergement, lang)}</h2>
    <!-- TODO client : renseigner l'hébergeur retenu et son adresse. -->
    <p class="mt-3 leading-relaxed">{t(ui.legal.hebergementTexte, lang)}</p>

    <h2 class={titreSection}>{t(ui.legal.propriete, lang)}</h2>
    <p class="mt-3 leading-relaxed">{t(ui.legal.proprieteTexte, lang)}</p>

    <h2 class={titreSection}>{t(ui.legal.donnees, lang)}</h2>
    <p class="mt-3 leading-relaxed">
      {remplir(t(ui.legal.donneesTexte, lang), { email: contact.email })}
    </p>

    <h2 class={titreSection}>{t(ui.legal.photos, lang)}</h2>
    <p class="mt-3 leading-relaxed">
      {remplir(t(ui.legal.photosTexte, lang), { email: contact.email })}
    </p>
  </section>
</Base>
