---
import Base from "../layouts/Base.astro";
import { domaines, cta } from "../data/site.js";
import { projets } from "../data/projets.js";
import { campagnes } from "../data/terrain.js";
import { t, lien } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;

const filtres = [
  { slug: "tous", titre: t(ui.realisations.toutes, lang), total: campagnes.length },
  ...domaines.map((domaine) => ({
    slug: domaine.slug,
    titre: t(domaine.titre, lang),
    total: campagnes.filter((campagne) => campagne.domaine === domaine.slug).length,
  })),
];

const nomDomaine = (slug) =>
  t(domaines.find((domaine) => domaine.slug === slug)?.titre, lang);
---

<Base
  lang={lang}
  titre={t(ui.menu.realisations, lang)}
  description={t(ui.realisations.sousTitre, lang)}
>
  <section class="relative isolate overflow-hidden bg-ist-700 py-24 text-white">
    <div
      class="absolute inset-0 bg-gradient-to-br from-ist-800 to-ist-600"
      aria-hidden="true"
    >
    </div>
    <div class="trame-ist absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <p class="surtitre text-ist-teal">{t(ui.menu.realisations, lang)}</p>
      <h1
        class="mt-4 max-w-3xl font-display text-4xl font-bold leading-tight sm:text-5xl"
      >
        {t(ui.realisations.titre, lang)}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ist-100">
        {t(ui.realisations.sousTitre, lang)}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div
      class="flex flex-wrap gap-3"
      role="group"
      aria-label={t(ui.realisations.filtrer, lang)}
    >
      {
        filtres.map((filtre, index) => (
          <button
            type="button"
            class:list={[
              "filtre rounded-full border px-5 py-2.5 text-sm font-semibold transition",
              index === 0
                ? "border-ist-600 bg-ist-600 text-white"
                : "border-ist-200 bg-white text-slate-600 hover:border-ist-600 hover:text-ist-600",
            ]}
            data-filtre={filtre.slug}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {filtre.titre}
            <span class="ml-1.5 opacity-70">({filtre.total})</span>
          </button>
        ))
      }
    </div>

    <ul id="grille" class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {
        campagnes.map((campagne) => (
          <li class="carte apparition" data-domaine={campagne.domaine}>
            <a
              href={lien(lang, `realisations/${campagne.slug}`)}
              class="group flex h-full flex-col overflow-hidden rounded-2xl border border-ist-100 bg-white shadow-carte transition hover:-translate-y-1 hover:shadow-carte-active"
            >
              <div class="relative overflow-hidden">
                <img
                  src={`/images/actions/${campagne.photos[0].src}.webp`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="aspect-16/10 w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ist-600 shadow-sm">
                  {nomDomaine(campagne.domaine)}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <p class="surtitre">{t(campagne.periode, lang)}</p>
                <h2 class="mt-2.5 font-display text-lg font-bold leading-snug text-ist-800">
                  {t(campagne.titre, lang)}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">
                  {t(campagne.extrait, lang)}
                </p>
                <p class="mt-4 text-sm text-slate-400">
                  {campagne.photos.length} {t(ui.realisations.photographies, lang)}
                </p>
                <span class="mt-auto pt-5 font-display text-sm font-semibold text-ist-red">
                  {t(ui.realisations.lire, lang)} →
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p id="aucun-resultat" class="mt-10 hidden text-center text-slate-500">
      {t(ui.realisations.aucune, lang)}
    </p>
  </section>

  <!-- Récapitulatif complet des projets documentés -->
  <section class="bg-ist-sand py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <details class="group rounded-2xl border border-ist-100 bg-white p-7 shadow-carte">
        <summary
          class="cursor-pointer font-display text-lg font-bold text-ist-700 marker:text-ist-teal"
        >
          {
            lang === "fr"
              ? `Tous les projets documentés (${projets.length})`
              : `All documented projects (${projets.length})`
          }
        </summary>
        <div class="mt-7 overflow-x-auto">
          <table class="w-full min-w-[760px] border-collapse text-left text-sm">
            <thead>
              <tr class="bg-ist-600 text-white">
                <th class="px-4 py-3 font-semibold">
                  {lang === "fr" ? "Action" : "Project"}
                </th>
                <th class="px-4 py-3 font-semibold">
                  {lang === "fr" ? "Période" : "Period"}
                </th>
                <th class="px-4 py-3 font-semibold">
                  {lang === "fr" ? "Public cible" : "Target group"}
                </th>
                <th class="px-4 py-3 font-semibold">
                  {t(ui.realisations.resultat, lang)}
                </th>
                <th class="px-4 py-3 font-semibold">
                  {t(ui.realisations.financement, lang)}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                projets.map((projet, rang) => (
                  <tr class={rang % 2 === 1 ? "bg-ist-sand" : "bg-white"}>
                    <td class="px-4 py-3 font-medium text-slate-800">
                      {t(projet.titre, lang)}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      {t(projet.periode, lang)}
                    </td>
                    <td class="px-4 py-3">{t(projet.cible, lang)}</td>
                    <td class="px-4 py-3">{t(projet.resultat, lang)}</td>
                    <td class="px-4 py-3">{t(projet.financement, lang)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-ist-700 py-20 text-white">
    <div class="trame-ist absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center sm:px-6"
    >
      <h2 class="font-display text-3xl font-bold sm:text-4xl">
        {t(ui.realisations.prochaine, lang)}
      </h2>
      <p class="max-w-2xl text-lg text-ist-100">
        {t(ui.accueil.soutenirTexte, lang)}
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-4">
        <a
          href={lien(lang, cta.chemin)}
          class="rounded-full bg-ist-red px-7 py-3.5 font-display font-semibold shadow-lg transition hover:bg-ist-red-dark"
          >{t(ui.menu.don, lang)}</a
        >
        <a
          href={lien(lang, "contact")}
          class="rounded-full border border-white/40 px-7 py-3.5 font-display font-semibold transition hover:bg-white hover:text-ist-700"
          >{t(ui.accueil.benevole, lang)}</a
        >
      </div>
    </div>
  </section>
</Base>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>(".filtre");
  const cartes = document.querySelectorAll<HTMLElement>(".carte");
  const messageVide = document.getElementById("aucun-resultat");

  const actif = ["border-ist-600", "bg-ist-600", "text-white"];
  const inactif = [
    "border-ist-200",
    "bg-white",
    "text-slate-600",
    "hover:border-ist-600",
    "hover:text-ist-600",
  ];

  const appliquer = (choix: string | undefined) => {
    boutons.forEach((bouton) => {
      const estChoisi = bouton.dataset.filtre === choix;
      bouton.setAttribute("aria-pressed", String(estChoisi));
      bouton.classList.remove(...(estChoisi ? inactif : actif));
      bouton.classList.add(...(estChoisi ? actif : inactif));
    });

    let visibles = 0;
    cartes.forEach((carte) => {
      const garder = choix === "tous" || carte.dataset.domaine === choix;
      carte.classList.toggle("hidden", !garder);
      if (garder) visibles += 1;
    });

    messageVide?.classList.toggle("hidden", visibles > 0);
  };

  // Un lien du type /realisations/#sante arrive avec le filtre déjà choisi.
  const depuisAncre = window.location.hash.replace("#", "");
  if (depuisAncre && [...boutons].some((b) => b.dataset.filtre === depuisAncre)) {
    appliquer(depuisAncre);
  }

  boutons.forEach((bouton) => {
    bouton.addEventListener("click", () => appliquer(bouton.dataset.filtre));
  });
</script>
