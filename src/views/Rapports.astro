---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EntetePage from "../components/EntetePage.astro";
import { agrements, site, contact } from "../data/site.js";
import { t } from "../i18n/index.js";
import { ui } from "../i18n/ui.js";

const { lang } = Astro.props;

const rapports = (await getCollection("rapports")).sort(
  (a, b) => b.data.annee - a.data.annee
);

---

<Base
  lang={lang}
  titre={t(ui.rapports.titre, lang)}
  description={t(ui.rapports.sousTitre, lang)}
>
  <EntetePage
    lang={lang}
    titre={t(ui.rapports.titre, lang)}
    accroche={t(ui.rapports.sousTitre, lang)}
  />

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-display text-3xl font-semibold text-ist-800">
      {t(ui.rapports.annuels, lang)}
    </h2>

    {
      rapports.length === 0 ? (
        <p class="mt-9 rounded-xl bg-voile/50 p-10 text-center text-encre-douce">
          {t(ui.rapports.aucun, lang)}
        </p>
      ) : (
        <ul class="mt-12 grid gap-9 sm:grid-cols-2 lg:grid-cols-3">
          {rapports.map((rapport) => {
            const titreRapport =
              (lang === "en" && rapport.data.titre_en) || rapport.data.titre;

            const couverture = rapport.data.couverture ? (
              <img
                src={rapport.data.couverture}
                alt={titreRapport}
                loading="lazy"
                class="aspect-3/4 w-full rounded-xl object-cover shadow-carte"
              />
            ) : (
              <div class="flex aspect-3/4 w-full flex-col items-center justify-center rounded-xl bg-gradient-to-br from-ist-700 to-ist-500 text-white shadow-carte">
                <span class="surtitre text-ist-200">
                  {t(ui.rapports.rapportAnnuel, lang)}
                </span>
                <span class="mt-3 font-display text-6xl font-semibold">
                  {rapport.data.annee}
                </span>
                <span class="mt-5 text-sm text-ist-100">{site.sigle}</span>
              </div>
            );

            return (
              <li data-reveal="flou">
                {rapport.data.fichier && !rapport.data.exemple ? (
                  <a
                    href={rapport.data.fichier}
                    target="_blank"
                    rel="noopener"
                    class="group block transition hover:-translate-y-1"
                  >
                    <div class="overflow-hidden rounded-xl">{couverture}</div>
                    <p class="mt-4 text-center font-display font-semibold text-ist-700 group-hover:text-ist-red">
                      {titreRapport}
                    </p>
                    <p class="mt-1 text-center text-sm text-encre-douce">
                      {t(ui.rapports.consulter, lang)}
                    </p>
                  </a>
                ) : (
                  <div class="opacity-60">
                    <div class="overflow-hidden rounded-xl grayscale">{couverture}</div>
                    <p class="mt-4 text-center font-display font-semibold text-encre-douce">
                      {titreRapport}
                    </p>
                    <p class="mt-1 text-center text-sm text-encre-douce">
                      {rapport.data.exemple
                        ? t(ui.rapports.exemple, lang)
                        : t(ui.rapports.bientot, lang)}
                    </p>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    <p class="mt-12 max-w-3xl text-sm leading-relaxed text-encre-douce">
      {t(ui.rapports.surDemande, lang)}{" "}
      <a
        class="font-medium text-ist-600 underline-offset-2 hover:underline"
        href={`mailto:${contact.email}?subject=${encodeURIComponent(t(ui.rapports.objetDemande, lang))}`}
        >{t(ui.rapports.demander, lang)}</a
      >.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-display text-3xl font-semibold text-ist-800">
      {t(ui.rapports.documents, lang)}
    </h2>
    <ul class="mt-9 grid gap-4 md:grid-cols-2">
      {
        agrements.map((agrement) => (
          <li class="rounded-xl border border-bordure p-6 shadow-carte" data-reveal="up">
            <p class="font-medium text-encre">{t(agrement.intitule, lang)}</p>
            <p class="mt-1 text-sm text-encre-douce">{t(agrement.date, lang)}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
